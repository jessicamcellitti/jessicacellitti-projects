<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Projects — Jessica Cellitti</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;600&display=swap');

  :root {
    --black: #111111;
    --gray-dark: #333333;
    --gray: #6b6b6b;
    --gray-light: #cfcfcf;
    --line: #e4e4e4;
    --white: #ffffff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', -apple-system, sans-serif;
    color: var(--black);
    background: var(--white);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  /* ===== HEADER ===== */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 48px;
    border-bottom: 1px solid var(--line);
  }
  .topbar .name {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.01em;
  }
  .topbar .back {
    font-size: 14px;
    color: var(--gray);
    transition: color 0.15s;
  }
  .topbar .back:hover { color: var(--black); }

  /* ===== MAIN ===== */
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 96px 24px 120px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 20px;
  }

  h1 {
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    font-size: clamp(32px, 5vw, 44px);
    margin-bottom: 56px;
  }

  /* ===== PROJECT LIST ===== */
  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project-row {
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .project-row:last-child { border-bottom: 1px solid var(--line); }

  .project-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }
  .project-link:hover .project-name { color: var(--gray-dark); }
  .project-link:hover .arrow { transform: translateX(3px); opacity: 1; }

  .project-name {
    font-family: 'DM Serif Display', serif;
    font-size: 21px;
    transition: color 0.15s;
  }

  .project-desc {
    font-size: 13.5px;
    color: var(--gray);
    text-align: right;
    flex-shrink: 0;
    max-width: 280px;
  }

  .arrow {
    display: none;
  }

  /* ===== COINS SUBGROUP ===== */
  .subgroup {
    padding-left: 0;
    margin-top: 4px;
  }
  .sub-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 0 10px 24px;
    border-top: 1px solid var(--line);
    font-size: 14.5px;
  }
  .sub-link:first-child { border-top: 1px solid var(--line); }
  .sub-link .sub-name { color: var(--gray-dark); }
  .sub-link:hover .sub-name { color: var(--black); }
  .sub-link .sub-desc { color: var(--gray-light); font-size: 13px; }

  @media (max-width: 560px) {
    .topbar { padding: 20px 24px; }
    main { padding: 64px 20px 96px; }
    .project-link { flex-direction: column; align-items: flex-start; gap: 4px; }
    .project-desc { text-align: left; max-width: none; }
    .sub-link { flex-direction: column; gap: 2px; padding-left: 16px; }
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="name">Jessica Cellitti</div>
  <a class="back" href="https://jessicacellitti.com">&larr; Back to portfolio</a>
</div>

<main>
  <div class="eyebrow">Projects</div>
  <h1>Work samples</h1>

  <div class="project-list">

    <div class="project-row">
      <a class="project-link" href="/flux">
        <span class="project-name">Flux</span>
        <span class="project-desc">knowledge infrastructure</span>
      </a>
    </div>

    <div class="project-row">
      <a class="project-link" href="/ai-fluency">
        <span class="project-name">AI Fluency</span>
        <span class="project-desc">adaptive AI-literacy prototype, built for Anthropic</span>
      </a>
    </div>

    <div class="project-row">
      <a class="project-link" href="/coins-learning-strategy">
        <span class="project-name">Coins</span>
      </a>
      <div class="subgroup">
        <a class="sub-link" href="/coins-onboarding">
          <span class="sub-name">CX onboarding course</span>
        </a>
        <a class="sub-link" href="/coins-learning-strategy">
          <span class="sub-name">CX learning strategy</span>
        </a>
        <a class="sub-link" href="/coins-lms">
          <span class="sub-name">LMS design mockup</span>
        </a>
      </div>
    </div>

    <div class="project-row">
      <a class="project-link" href="/trunk-tools-track">
        <span class="project-name">TrunkSubmittal</span>
        <span class="project-desc">certification track, built for Trunk Tools</span>
      </a>
    </div>

    <div class="project-row">
      <a class="project-link" href="/the-score">
        <span class="project-name">Conductor</span>
        <span class="project-desc">content dashboard</span>
      </a>
    </div>

  </div>
</main>

</body>
</html>
