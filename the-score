const staleCount = libraryData.filter(d => d.fresh === 'stale').length;
const ticketed = libraryData.filter(d => d.ticket);
const channels = {};
libraryData.forEach(d => { channels[d.channel] = (channels[d.channel]||0) + 1; });
const stages = [
  {key:'first-login', label:'First login'},
  {key:'onboarding', label:'Onboarding'},
  {key:'adoption', label:'Adoption'},
  {key:'maturity', label:'Ongoing maturity'},
  {key:'advocacy', label:'Advocacy'},
