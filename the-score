let tourIndex = 0;
const tourOverlay = document.getElementById('tourOverlay');
const tourBody = document.getElementById('tourBody');
const tourStepLabel = document.getElementById('tourStepLabel');
const tourDots = document.getElementById('tourDots');
const tourBack = document.getElementById('tourBack');
const tourNext = document.getElementById('tourNext');

function renderTourStep(){
  const step = tourSteps[tourIndex];
  tourStepLabel.textContent = `Step ${tourIndex+1} of ${tourSteps.length} — ${step.label}`;
  tourDots.innerHTML = tourSteps.map((_, i) => `<span class="tour-dot ${i===tourIndex?'active':''}"></span>`).join('');
  tourBody.innerHTML = step.render();
  tourBack.disabled = tourIndex === 0;
  tourNext.textContent = tourIndex === tourSteps.length - 1 ? 'Done' : 'Next →';
  if(step.onRender) step.onRender();
  tourBody.scrollTop = 0;
}

function openTour(){
  tourIndex = 0;
  renderTourStep();
  tourOverlay.classList.add('open');
}
function closeTour(){ tourOverlay.classList.remove('open'); }

document.getElementById('tourBtn').addEventListener('click', openTour);
document.getElementById('tourClose').addEventListener('click', closeTour);
document.getElementById('tourSkip').addEventListener('click', closeTour);
tourOverlay.addEventListener('click', (e) => { if(e.target === tourOverlay) closeTour(); });
tourNext.addEventListener('click', () => {
  if(tourIndex === tourSteps.length - 1){ closeTour(); return; }
  tourIndex++; renderTourStep();
});
tourBack.addEventListener('click', () => { if(tourIndex > 0){ tourIndex--; renderTourStep(); } });
document.addEventListener('keydown', (e) => {
  if(!tourOverlay.classList.contains('open')) return;
  if(e.key === 'Escape') closeTour();
  if(e.key === 'ArrowRight') tourNext.click();
  if(e.key === 'ArrowLeft' && tourIndex > 0) tourBack.click();
});
