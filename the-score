const stageCounts = stages.map(s => ({...s, count: libraryData.filter(d => d.stage === s.key).length}));
const channelCount = Object.keys(channels).length;
const largestStage = stageCounts.reduce((a,b) => b.count > a.count ? b : a);
const concentrationPct = Math.round(largestStage.count / total * 100);
const thinStages = stageCounts.filter(s => s.count <= 4).length;

