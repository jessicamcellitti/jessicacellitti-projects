<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>the score — Conductor Content Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0D1013; --surface:#171B21; --surface-2:#1F252D; --surface-3:#262D37;
    --border:#333B47; --border-soft:#242A33;
    --text:#F4F6F8; --text-dim:#C6CDD6; --text-faint:#8890A0;
    --blue:#5FB2E8; --teal:#2FC2AC; --pink:#EA6B93; --purple:#A67CC2;
    --green:#B4DE5C; --amber:#F0B24E; --red:#F0716F;
    --radius:12px; --mono:'IBM Plex Mono', monospace; --display:'Space Grotesk', sans-serif; --body:'Inter', sans-serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{background:var(--bg); color:var(--text); font-family:var(--body); font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased;}
  a{color:inherit;}
  ::selection{background:var(--teal); color:#08110F;}
  .wrap{max-width:1280px; margin:0 auto; padding:0 44px;}

  header.top{border-bottom:1px solid var(--border-soft); padding:16px 0; position:sticky; top:0; z-index:60; background:rgba(13,16,19,0.94); backdrop-filter:blur(10px);}
  .top-row{display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;}
  .brand{font-family:var(--mono); font-size:13px; letter-spacing:0.05em; color:var(--text-dim); text-transform:uppercase; display:flex; align-items:center; gap:10px;}
  .brand .dot{width:7px; height:7px; border-radius:50%; background:var(--teal); box-shadow:0 0 8px var(--teal);}
  .client-badge{
    font-family:var(--mono); font-size:12px; letter-spacing:0.04em; color:var(--blue);
    border:1px solid rgba(95,178,232,0.35); background:rgba(95,178,232,0.08);
    padding:5px 12px; border-radius:100px; display:flex; align-items:center; gap:7px;
  }
  .client-badge svg{width:13px; height:13px;}
  .tour-btn{
    font-family:var(--mono); font-size:12.5px; color:var(--bg); background:var(--teal);
    border:none; padding:8px 16px; border-radius:100px; cursor:pointer; font-weight:600;
    letter-spacing:0.02em; transition:opacity .15s;
  }
  .tour-btn:hover{opacity:.85;}
  .header-actions{display:flex; align-items:center; gap:12px;}

  .dash{padding-top:36px;}
  .dash-label{font-family:var(--mono); font-size:13px; color:var(--teal); text-transform:uppercase; letter-spacing:.06em; margin-bottom:14px; font-weight:600;}
  .dash-label .qualifier{color:var(--text-faint); font-weight:400; text-transform:none; letter-spacing:0; margin-left:8px;}

  /* ---------- KPI ROW ---------- */
  .kpi-row{display:grid; grid-template-columns:repeat(5,1fr); gap:1px; background:var(--border-soft); border:1px solid var(--border-soft); border-radius:var(--radius); overflow:hidden;}
  .kpi{background:var(--surface); padding:18px 18px; cursor:pointer; transition:background .15s;}
  .kpi:hover{background:var(--surface-2);}
  .kpi-num{font-family:var(--display); font-size:27px; font-weight:600; letter-spacing:-0.01em;}
  .kpi-num.amber{color:var(--amber);} .kpi-num.red{color:var(--red);} .kpi-num.teal{color:var(--teal);} .kpi-num.green{color:var(--green);}
  .kpi-label{font-size:12.5px; color:var(--text-dim); margin-top:6px; line-height:1.45;}

  /* ---------- PANEL GRID ---------- */
  .panel-grid{display:grid; grid-template-columns:1.1fr 1fr; gap:14px; margin-top:14px;}
  .panel{background:var(--surface); border:1px solid var(--border-soft); border-radius:var(--radius); padding:20px 22px;}
  .panel-title{font-family:var(--display); font-weight:600; font-size:15px; margin-bottom:14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;}
  .panel-sub{font-size:12.5px; color:var(--text-dim); font-weight:400; font-family:var(--mono);}

  /* content health bar */
  .health-bar{display:flex; height:10px; border-radius:100px; overflow:hidden; background:var(--surface-3); margin-bottom:14px;}
  .health-seg.fresh{background:var(--green);}
  .health-seg.aging{background:var(--amber);}
  .health-seg.stale{background:var(--red);}
  .health-legend{display:flex; gap:18px; font-family:var(--mono); font-size:11.5px; color:var(--text-dim); margin-bottom:16px;}
  .health-legend span{display:flex; align-items:center; gap:6px;}
  .health-legend .dot{width:7px; height:7px; border-radius:50%; display:inline-block;}
  .ticket-list{display:flex; flex-direction:column; gap:8px;}
  .ticket-row{display:flex; justify-content:space-between; align-items:center; padding:8px 10px; background:var(--surface-2); border-radius:7px; font-size:13px; cursor:pointer; transition:background .15s;}
  .ticket-row:hover{background:var(--surface-3);}
  .ticket-name{color:var(--text-dim); font-family:var(--body);}
  .ticket-id{font-family:var(--mono); font-size:11.5px; color:var(--blue);}

  /* lifecycle + channel bars */
  .bar-group{margin-bottom:18px;}
  .bar-group:last-child{margin-bottom:0;}
  .bar-row{display:grid; grid-template-columns:130px 1fr 30px; align-items:center; gap:10px; margin-bottom:8px;}
  .bar-row-label{color:var(--text-dim); font-family:var(--body); font-size:13px;}
  .bar-track{height:8px; background:var(--surface-3); border-radius:100px; overflow:hidden;}
  .bar-fill{height:100%; border-radius:100px; background:var(--teal);}
  .bar-fill.thin{background:var(--red);}
  .bar-count{color:var(--text-faint); font-family:var(--mono); font-size:11.5px; text-align:right;}

  /* ---------- SECTION SHELL ---------- */
  section{padding:44px 0 80px;}
  .sec-head{display:flex; justify-content:space-between; align-items:flex-end; gap:24px; margin-bottom:22px; flex-wrap:wrap;}
  .sec-tag{font-family:var(--mono); font-size:13px; color:var(--teal); text-transform:uppercase; letter-spacing:.06em; margin-bottom:10px; font-weight:600;}
  h2{font-family:var(--display); font-size:22px; font-weight:600; letter-spacing:-0.01em;}
  .sec-desc{color:var(--text-dim); font-size:13.5px; max-width:580px; margin-top:6px; line-height:1.6;}

  .pills{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;}
  .pill{font-family:var(--mono); font-size:12px; padding:7px 14px; border-radius:100px; border:1px solid var(--border); color:var(--text-dim); cursor:pointer; background:transparent; transition:all .15s; display:flex; align-items:center; gap:7px;}
  .pill:hover{border-color:var(--text-faint); color:var(--text);}
  .pill.active{background:var(--surface-3); border-color:var(--teal); color:var(--teal);}
  .pill-n{opacity:.65; font-size:11px;}

  .lib-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:12px;}
  .lib-card{background:var(--surface); border:1px solid var(--border-soft); border-radius:var(--radius); padding:16px; cursor:pointer; transition:border-color .15s, background .15s; display:flex; flex-direction:column; gap:9px; min-height:150px;}
  .lib-card:hover{border-color:var(--text-faint); background:var(--surface-2);}
  .lib-card.hidden{display:none;}
  .lib-name{font-family:var(--display); font-weight:600; font-size:14.5px; line-height:1.32;}
  .lib-teaser{font-size:12.5px; color:var(--text-dim); line-height:1.5; flex:1;}
  .lib-fresh-row{display:flex; align-items:center; gap:6px; font-family:var(--mono); font-size:10.5px; color:var(--text-faint);}
  .fresh-dot{width:6px; height:6px; border-radius:50%; display:inline-block; flex-shrink:0;}
  .fresh-fresh{background:var(--green);} .fresh-aging{background:var(--amber);} .fresh-stale{background:var(--red);}
  .lib-tags{display:flex; gap:6px; flex-wrap:wrap; margin-top:auto; padding-top:2px;}
  .tag{display:inline-flex; align-items:center; gap:5px; font-family:var(--mono); font-size:10.5px; padding:3px 8px; border-radius:5px; border:1px solid var(--border); color:var(--text-dim); white-space:nowrap;}
  .tag.ticket-tag{color:var(--blue); border-color:rgba(95,178,232,.35);}

  .panel.flash{animation:flashPanel 1.1s ease;}
  @keyframes flashPanel{0%{box-shadow:0 0 0 2px var(--teal);} 100%{box-shadow:0 0 0 0px transparent;}}
  .ticket-row.flash{animation:flashRow 1.1s ease;}
  @keyframes flashRow{0%{background:rgba(47,194,172,0.35);} 100%{background:var(--surface-2);}}

  .lib-search{
    width:100%; margin-bottom:16px; padding:11px 16px; border-radius:9px;
    background:var(--surface); border:1px solid var(--border); color:var(--text);
    font-family:var(--body); font-size:13.5px;
  }
  .lib-search::placeholder{color:var(--text-faint);}
  .lib-search:focus{outline:none; border-color:var(--teal);}

  .stage-group-head{
    font-family:var(--display); font-weight:600; font-size:14px; color:var(--text-dim);
    margin:26px 0 12px; padding-top:14px; border-top:1px solid var(--border-soft);
    display:flex; align-items:center; gap:10px;
  }
  .stage-group-head:first-child{margin-top:0; padding-top:0; border-top:none;}
  .stage-group-count{font-family:var(--mono); font-size:11px; color:var(--text-faint); font-weight:400;}

  .ch-dot{width:7px; height:7px; border-radius:50%; flex-shrink:0;}
  .ch-kb{background:var(--blue);} .ch-community{background:var(--pink);} .ch-live{background:var(--purple);}
  .ch-docs{background:var(--green);} .ch-mixed{background:var(--teal);}

  .drawer-overlay{position:fixed; inset:0; background:rgba(6,8,10,0.7); z-index:100; opacity:0; pointer-events:none; transition:opacity .2s;}
  .drawer-overlay.open{opacity:1; pointer-events:auto;}
  .drawer{position:fixed; top:0; right:0; bottom:0; width:min(460px, 92vw); background:var(--surface); border-left:1px solid var(--border); z-index:101; padding:28px; overflow-y:auto; transform:translateX(100%); transition:transform .25s ease;}
  .drawer.open{transform:translateX(0);}
  .drawer-close{background:none; border:1px solid var(--border); color:var(--text-dim); border-radius:8px; width:32px; height:32px; cursor:pointer; font-size:16px; float:right;}
  .drawer-close:hover{border-color:var(--text-faint); color:var(--text);}
  .drawer h3{font-family:var(--display); font-size:20px; font-weight:600; margin:44px 0 6px; line-height:1.3;}
  .drawer-source{font-family:var(--mono); font-size:11.5px; color:var(--blue); word-break:break-all;}
  .drawer-desc{font-size:14px; color:var(--text-dim); margin:16px 0; line-height:1.65;}
  .drawer-field{padding:11px 0; border-top:1px solid var(--border-soft);}
  .drawer-field-label{font-family:var(--mono); font-size:10.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--text-faint); margin-bottom:5px;}
  .drawer-field-val{font-size:13.5px; color:var(--text);}
  .info-tag{font-family:var(--mono); font-size:10.5px; color:var(--amber); text-transform:uppercase; letter-spacing:.04em; border:1px solid rgba(240,178,78,0.35); background:rgba(240,178,78,0.08); padding:4px 9px; border-radius:5px; display:inline-block; margin-bottom:12px;}
  .info-list{display:flex; flex-direction:column; gap:8px; margin-top:16px;}
  .info-row{display:flex; justify-content:space-between; align-items:center; padding:10px 12px; background:var(--surface-2); border-radius:8px; font-size:13px; flex-wrap:wrap; gap:4px;}
  .info-row-name{color:var(--text);}
  .info-row-meta{font-family:var(--mono); font-size:11px; color:var(--text-faint);}
  .funnel-row{margin-bottom:14px;}
  .funnel-label{font-size:12.5px; color:var(--text-dim); display:flex; justify-content:space-between; margin-bottom:6px;}
  .funnel-label b{color:var(--text); font-family:var(--mono);}
  .funnel-track{height:8px; background:var(--surface-3); border-radius:100px; overflow:hidden;}
  .funnel-fill{height:100%; border-radius:100px; background:var(--teal);}

  footer{padding:30px 0 60px; border-top:1px solid var(--border-soft);}
  .foot-name{font-family:var(--display); font-weight:600; font-size:13.5px;}
  .foot-note{font-family:var(--mono); font-size:11px; color:var(--text-faint); max-width:600px; line-height:1.6; margin-top:6px;}

  @media (max-width:1100px){.lib-grid{grid-template-columns:repeat(3,1fr);} .kpi-row{grid-template-columns:repeat(3,1fr);} .panel-grid{grid-template-columns:1fr;}}
  @media (max-width:760px){
    .lib-grid{grid-template-columns:repeat(2,1fr);}
    .kpi-row{grid-template-columns:repeat(2,1fr);}
    .client-badge span, .client-badge{font-size:11px; padding:5px 10px;}
    .tour-btn{font-size:11.5px; padding:7px 13px;}
    .top-row{gap:10px;}
  }
  @media (max-width:520px){
    .wrap{padding:0 18px;}
    .lib-grid{grid-template-columns:1fr;}
    .kpi-row{grid-template-columns:1fr 1fr;}
    .header-actions{gap:8px; flex-wrap:wrap; justify-content:flex-end;}
    .client-badge{display:none;}
    .ticket-row{flex-wrap:wrap; gap:4px;}
    .ticket-name{word-break:break-word;}
    .bar-row{grid-template-columns:90px 1fr 26px; gap:6px;}
    .bar-row-label{font-size:11.5px;}
  }
  @media (max-width:400px){
    .kpi-row{grid-template-columns:1fr;}
  }
  /* ===================== TOUR OVERLAY ===================== */
  .tour-overlay{
    position:fixed; inset:0; background:rgba(6,8,10,0.86); z-index:200;
    display:flex; align-items:center; justify-content:center; padding:24px;
    opacity:0; pointer-events:none; transition:opacity .2s;
  }
  .tour-overlay.open{opacity:1; pointer-events:auto;}
  .tour-card{
    background:var(--surface); border:1px solid var(--border); border-radius:16px;
    width:min(760px, 100%); max-height:88vh; overflow-y:auto; padding:36px 40px;
    position:relative;
  }
  .tour-top{display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;}
  .tour-step-label{font-family:var(--mono); font-size:12px; color:var(--teal); letter-spacing:.05em; text-transform:uppercase; font-weight:600;}
  .tour-dots{display:flex; gap:6px; margin-top:10px;}
  .tour-dot{width:20px; height:3px; border-radius:2px; background:var(--border);}
  .tour-dot.active{background:var(--teal);}
  .tour-close{background:none; border:1px solid var(--border); color:var(--text-dim); border-radius:8px; width:30px; height:30px; cursor:pointer; font-size:15px;}
  .tour-close:hover{border-color:var(--text-faint); color:var(--text);}
  .tour-body{min-height:280px;}
  .tour-eyebrow{font-family:var(--mono); font-size:11.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--amber); margin-bottom:14px;}
  .tour-h{font-family:var(--display); font-weight:600; font-size:26px; line-height:1.2; letter-spacing:-0.01em; margin-bottom:14px;}
  .tour-h em{font-style:normal; color:var(--teal);}
  .tour-p{color:var(--text-dim); font-size:14.5px; line-height:1.65; margin-bottom:16px; max-width:600px;}
  .tour-callout{
    padding:14px 16px; border-radius:9px; background:rgba(240,113,111,0.08);
    border:1px solid rgba(240,113,111,0.3); color:#F5A3A1; font-size:13.5px; line-height:1.6; margin-top:8px;
  }
  .tour-nav{display:flex; justify-content:space-between; align-items:center; margin-top:28px; padding-top:20px; border-top:1px solid var(--border-soft);}
  .tour-skip{font-family:var(--mono); font-size:12.5px; color:var(--text-faint); background:none; border:none; cursor:pointer;}
  .tour-skip:hover{color:var(--text-dim);}
  .tour-next-group{display:flex; gap:10px;}
  .tour-nav-btn{
    font-family:var(--mono); font-size:12.5px; padding:9px 18px; border-radius:100px; cursor:pointer;
    border:1px solid var(--border); background:transparent; color:var(--text-dim);
  }
  .tour-nav-btn:hover{border-color:var(--text-faint); color:var(--text);}
  .tour-nav-btn.primary{background:var(--teal); border-color:var(--teal); color:var(--bg); font-weight:600;}
  .tour-nav-btn.primary:hover{opacity:.85;}
  .tour-nav-btn:disabled{opacity:.35; cursor:default;}

  /* signal cards (tour step 2) */
  .t-signal-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:12px;}
  .t-signal-card{background:var(--surface-2); border:1px solid var(--border-soft); border-radius:10px; padding:16px; display:flex; flex-direction:column; gap:9px;}
  .t-signal-persona{font-family:var(--display); font-weight:600; font-size:14px;}
  .t-signal-row{font-size:12px; color:var(--text-dim); display:flex; flex-direction:column; gap:2px;}
  .t-signal-row span{color:var(--text-faint); font-family:var(--mono); font-size:10px; text-transform:uppercase; letter-spacing:.03em;}
  .t-signal-status{margin-top:auto; font-family:var(--mono); font-size:10.5px; padding:6px 9px; border-radius:6px; text-align:center; text-transform:uppercase; letter-spacing:.03em;}
  .t-status-gap{background:rgba(240,178,78,0.12); color:var(--amber); border:1px solid rgba(240,178,78,0.35);}
  .t-status-critical{background:rgba(240,113,111,0.12); color:var(--red); border:1px solid rgba(240,113,111,0.35);}
  .t-status-under{background:rgba(95,178,232,0.12); color:var(--blue); border:1px solid rgba(95,178,232,0.35);}

  /* trigger demo (tour step 3) */
  .t-trig-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:18px;}
  .t-trig{text-align:left; background:var(--surface-2); border:1px solid var(--border-soft); border-radius:9px; padding:12px; cursor:pointer; transition:all .15s; color:var(--text); font-family:var(--body);}
  .t-trig:hover{border-color:var(--text-faint);}
  .t-trig.active{border-color:var(--teal); box-shadow:0 0 0 1px var(--teal) inset;}
  .t-trig-day{font-family:var(--mono); font-size:10px; color:var(--amber); text-transform:uppercase; letter-spacing:.04em;}
  .t-trig.active .t-trig-day{color:var(--teal);}
  .t-trig-title{font-size:12.5px; font-weight:600; margin-top:5px; line-height:1.25;}
  .t-orch-output{display:grid; grid-template-columns:1fr 1fr; gap:0; border:1px solid var(--border-soft); border-radius:10px; overflow:hidden;}
  .t-orch-code{background:#0A0D10; padding:16px 18px; border-right:1px solid var(--border-soft);}
  .t-orch-label{font-family:var(--mono); font-size:10px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.05em; margin-bottom:10px;}
  .t-code{font-family:var(--mono); font-size:11.5px; line-height:1.7; color:#C7D0D9; white-space:pre-wrap;}
  .t-code .k{color:var(--purple);} .t-code .s{color:var(--green);} .t-code .c{color:var(--text-faint);} .t-code .fn{color:var(--blue);}
  .t-orch-results{padding:16px 18px; background:var(--surface-2);}
  .t-result-item{display:flex; align-items:flex-start; gap:8px; padding:8px 0; border-bottom:1px solid var(--border-soft); font-size:12.5px;}
  .t-result-item:last-child{border-bottom:none;}
  .t-result-check{color:var(--teal); font-family:var(--mono); font-size:12px;}
  .t-result-name{font-weight:500;}
  .t-result-channel{font-family:var(--mono); font-size:10.5px; color:var(--text-faint); margin-top:2px;}
  .t-gap-flag{margin-top:10px; padding:10px 12px; border-radius:7px; background:rgba(240,113,111,0.09); border:1px solid rgba(240,113,111,0.35); color:#F5A3A1; font-size:11.5px; font-family:var(--mono); line-height:1.55;}
  .t-orch-note{margin-top:12px; font-size:11.5px; color:var(--text-faint); font-family:var(--mono); line-height:1.6;}

  /* stack list (tour step 4) */
  .t-stack-list{display:flex; flex-direction:column; gap:8px;}
  .t-stack-row{display:flex; justify-content:space-between; align-items:center; padding:12px 14px; background:var(--surface-2); border-radius:8px;}
  .t-stack-name{font-family:var(--display); font-weight:600; font-size:14px;}
  .t-stack-role{font-size:12px; color:var(--text-dim); margin-top:3px;}
  .t-stack-badge{font-family:var(--mono); font-size:10px; text-transform:uppercase; letter-spacing:.03em; padding:4px 8px; border-radius:5px; flex-shrink:0; margin-left:12px;}
  .t-stack-badge.v{color:var(--green); background:rgba(180,222,92,0.1); border:1px solid rgba(180,222,92,0.3);}
  .t-stack-badge.g{color:var(--text-faint); background:transparent; border:1px solid var(--border);}
  @media (max-width:640px){
    .tour-overlay{padding:0;}
    .tour-card{width:100%; height:100%; max-height:100%; border-radius:0; padding:20px 18px 24px;}
    .t-signal-grid{grid-template-columns:1fr;}
    .t-trig-grid{grid-template-columns:repeat(2,1fr);}
    .t-orch-output{grid-template-columns:1fr;}
    .t-orch-code{border-right:none; border-bottom:1px solid var(--border-soft);}
    .tour-h{font-size:22px !important;}
    .tour-nav{flex-wrap:wrap; gap:12px;}
    .tour-next-group{width:100%; justify-content:space-between;}
