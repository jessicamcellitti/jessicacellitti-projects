<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COINS CX Onboarding</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --teal: #36c6b0;
  --blue: #4169bf;
  --teal-dim: rgba(54,198,176,0.12);
  --teal-glow: rgba(54,198,176,0.25);
  --blue-dim: rgba(65,105,191,0.15);
  --black: #0d1b2a;
  --surface: #132234;
  --surface2: #1a2e42;
  --surface3: #213650;
  --border: rgba(255,255,255,0.07);
  --border-teal: rgba(54,198,176,0.3);
  --text: #e8f0f7;
  --text-muted: #7a9ab5;
  --text-dim: #4a6480;
  --white: #ffffff;
  --green: #36c6b0;
  --amber: #f0a500;
  --sidebar-w: 280px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--black);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ── LAYOUT ──────────────────────────────────────────────── */
#app { display: flex; min-height: 100vh; }

/* ── SIDEBAR ─────────────────────────────────────────────── */
#sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
  position: fixed; top: 0; left: 0;
  z-index: 100; transition: transform 0.3s ease;
  overflow-y: auto;
}

.sidebar-header { padding: 24px 20px 20px; border-bottom: 1px solid var(--border); }

.logo-wrap { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.logo-img { height: 56px; width: auto; mix-blend-mode: screen; }

.progress-track { height: 3px; background: var(--surface3); border-radius: 2px; overflow: hidden; }
.progress-fill { height: 100%; background: var(--teal); border-radius: 2px; transition: width 0.5s ease; }
.progress-label { font-size: 11px; color: var(--text-muted); margin-top: 8px; display: flex; justify-content: space-between; }

.nav-section { padding: 8px 0; }
.nav-item {
  display: flex; align-items: center; gap: 12px;
  padding: 11px 20px; cursor: pointer;
  transition: all 0.2s; position: relative;
  border: none; background: none; width: 100%; text-align: left;
  color: #8ab0cc; font-family: 'DM Sans', sans-serif;
  font-size: 14px; font-weight: 500;
}
.nav-item:hover { color: var(--text); background: var(--surface2); }
.nav-item.active { color: var(--white); background: var(--teal-dim); }
.nav-item.active::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0;
  width: 2px; background: var(--teal);
}
.nav-item.completed .nav-check { color: var(--teal); opacity: 1; }

.nav-num {
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--surface3); border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 600; color: var(--text-dim);
  flex-shrink: 0; transition: all 0.2s; font-family: 'DM Mono', monospace;
}
.nav-item.active .nav-num { background: var(--teal); border-color: var(--teal); color: white; }
.nav-item.completed .nav-num { background: rgba(54,198,176,0.15); border-color: rgba(54,198,176,0.4); color: var(--teal); }
.nav-title { flex: 1; line-height: 1.3; }
.nav-check { opacity: 0; font-size: 12px; }

/* ── MAIN ─────────────────────────────────────────────── */
#main { flex: 1; display: flex; flex-direction: column; min-height: 100vh; transition: margin-left 0.3s ease; }

/* ── TOPBAR ──────────────────────────────────────────────── */
#topbar {
  height: 56px; background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 48px; position: sticky; top: 0; z-index: 50;
}
.topbar-breadcrumb { font-size: 12px; color: var(--text-muted); }
.topbar-breadcrumb span { color: var(--text); }
.tag-pill {
  font-size: 11px; padding: 3px 10px; border-radius: 20px;
  background: var(--teal-dim); color: var(--teal);
  border: 1px solid var(--border-teal); font-weight: 500; letter-spacing: 0.04em;
}

/* ── CONTENT AREA ────────────────────────────────────────── */
#content-wrap { flex: 1; display: flex; flex-direction: row; align-items: flex-start; min-height: calc(100vh - 56px); }

#content { flex: 1; padding: 48px 64px; min-width: 0; max-width: 860px; }

/* ── RIGHT TOC PANEL ─────────────────────────────────────── */
#toc-panel { display: none; width: 200px; flex-shrink: 0; padding: 48px 24px 48px 0; margin-right: 32px; }
#toc-inner { position: sticky; top: 72px; }
.toc-label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #6a8faa; font-weight: 600; margin-bottom: 14px; font-family: 'DM Mono', monospace; }
#toc-list { display: flex; flex-direction: column; gap: 2px; }
.toc-item { font-size: 13px; line-height: 1.5; color: #6a8faa; padding: 6px 0 6px 14px; border-left: 2px solid transparent; cursor: pointer; transition: all 0.2s; text-decoration: none; display: block; }
.toc-item:hover { color: #a0c4dd; border-left-color: var(--border); }
.toc-item.active { color: var(--white); border-left-color: var(--teal); }

@media (min-width: 1280px) {
  #toc-panel { display: block; }
  #content { max-width: 820px; padding: 48px 56px; }
}

/* ── MODULE HEADER ───────────────────────────────────────── */
.module-eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); font-weight: 600; margin-bottom: 12px; font-family: 'DM Mono', monospace; }
.module-title { font-size: 36px; font-weight: 700; line-height: 1.15; color: var(--white); margin-bottom: 12px; letter-spacing: -0.02em; }
.module-tagline { font-size: 17px; color: var(--text-muted); line-height: 1.6; margin-bottom: 40px; font-weight: 400; }
.module-divider { height: 1px; background: var(--border); margin-bottom: 40px; }

/* ── TYPOGRAPHY ──────────────────────────────────────────── */
.section-h2 { font-size: 20px; font-weight: 600; color: var(--white); margin: 40px 0 14px; letter-spacing: -0.01em; }
.section-h3 { font-size: 15px; font-weight: 600; color: var(--teal); margin: 28px 0 10px; text-transform: uppercase; letter-spacing: 0.06em; font-family: 'DM Mono', monospace; }
.prose { font-size: 15px; line-height: 1.8; color: #b8d0e8; margin-bottom: 16px; }
.prose strong { color: var(--white); font-weight: 600; }

/* ── CALLOUTS ────────────────────────────────────────────── */
.callout { border-radius: 10px; padding: 18px 20px; margin: 24px 0; border: 1px solid; }
.callout-blue { background: var(--blue-dim); border-color: rgba(65,105,191,0.3); }
.callout-teal { background: var(--teal-dim); border-color: var(--border-teal); }
.callout-green { background: rgba(54,198,176,0.08); border-color: rgba(54,198,176,0.25); }
.callout-amber { background: rgba(240,165,0,0.08); border-color: rgba(240,165,0,0.25); }
.callout-label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; margin-bottom: 7px; font-family: 'DM Mono', monospace; }
.callout-blue .callout-label { color: #7a9fe8; }
.callout-teal .callout-label, .callout-green .callout-label { color: var(--teal); }
.callout-amber .callout-label { color: var(--amber); }
.callout-body { font-size: 14px; line-height: 1.75; color: #b8d0e8; }

/* ── LISTS ───────────────────────────────────────────────── */
.bullet-list { list-style: none; margin: 12px 0 20px; }
.bullet-list li { font-size: 14px; line-height: 1.75; color: #a8c8e0; padding: 5px 0 5px 20px; position: relative; }
.bullet-list li::before { content: ''; position: absolute; left: 0; top: 13px; width: 6px; height: 6px; border-radius: 50%; background: var(--teal); }

.num-list { list-style: none; counter-reset: step; margin: 12px 0 20px; }
.num-list li { font-size: 14px; line-height: 1.75; color: #a8c8e0; padding: 7px 0 7px 36px; position: relative; counter-increment: step; }
.num-list li::before { content: counter(step); position: absolute; left: 0; top: 6px; width: 22px; height: 22px; border-radius: 50%; background: var(--teal-dim); border: 1px solid var(--border-teal); color: var(--teal); font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; font-family: 'DM Mono', monospace; }

.check-list { list-style: none; margin: 12px 0 20px; }
.check-list li { font-size: 14px; line-height: 1.75; color: #a8c8e0; padding: 5px 0 5px 26px; position: relative; }
.check-list li::before { content: '✓'; position: absolute; left: 0; top: 5px; color: var(--teal); font-weight: 700; font-size: 13px; }

/* ── TABLE ───────────────────────────────────────────────── */
.data-table { width: 100%; border-collapse: collapse; margin: 20px 0 28px; font-size: 13px; }
.data-table th { background: var(--surface2); color: var(--text-muted); padding: 10px 14px; text-align: left; font-weight: 600; font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; border-bottom: 1px solid var(--border); font-family: 'DM Mono', monospace; }
.data-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); color: #a8c8e0; line-height: 1.5; vertical-align: top; }
.data-table tr:last-child td { border-bottom: none; }
.data-table tr:hover td { background: var(--surface2); }
.data-table td:first-child { color: var(--white); font-weight: 500; }
.data-table td.highlight { color: var(--teal); font-weight: 500; }

/* ── QUOTE ───────────────────────────────────────────────── */
.quote-block { border-left: 3px solid var(--teal); margin: 24px 0; padding: 16px 0 16px 24px; }
.quote-text { font-size: 16px; line-height: 1.7; color: #d0e8f5; font-style: italic; margin-bottom: 8px; }
.quote-attr { font-size: 13px; color: var(--text-muted); font-weight: 500; }

/* ── REFLECTION ──────────────────────────────────────────── */
.reflection-section { margin: 48px 0 0; padding-top: 40px; border-top: 1px solid var(--border); }
.reflection-title { font-size: 18px; font-weight: 600; color: var(--white); margin-bottom: 6px; }
.reflection-sub { font-size: 13px; color: var(--text-muted); margin-bottom: 28px; line-height: 1.6; }
.reflection-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 20px; transition: border-color 0.2s; }
.reflection-card:focus-within { border-color: var(--border-teal); }
.reflection-q { font-size: 14px; font-weight: 500; color: var(--white); margin-bottom: 12px; line-height: 1.5; }
.reflection-input { width: 100%; min-height: 80px; resize: vertical; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-family: 'DM Sans', sans-serif; font-size: 14px; line-height: 1.6; padding: 12px 14px; outline: none; transition: border-color 0.2s; }
.reflection-input:focus { border-color: var(--border-teal); }
.reflection-input::placeholder { color: var(--text-dim); }

.btn-feedback { margin-top: 10px; background: var(--teal-dim); border: 1px solid var(--border-teal); color: var(--teal); padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.2s; display: flex; align-items: center; gap: 6px; }
.btn-feedback:hover { background: rgba(54,198,176,0.22); }

.static-feedback { margin-top: 12px; padding: 14px 16px; background: rgba(54,198,176,0.06); border: 1px solid rgba(54,198,176,0.2); border-radius: 8px; font-size: 14px; line-height: 1.75; color: #a8d8c8; display: none; }
.static-feedback.visible { display: block; }
.fb-label { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--teal); margin-bottom: 6px; font-family: 'DM Mono', monospace; }

/* ── NAV FOOTER ──────────────────────────────────────────── */
.nav-footer { display: flex; justify-content: space-between; align-items: center; padding: 40px 0 64px; margin-top: 48px; border-top: 1px solid var(--border); }
.btn-nav { display: flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.2s; text-decoration: none; border: none; }
.btn-prev { background: var(--surface2); border: 1px solid var(--border); color: var(--text); }
.btn-prev:hover { border-color: var(--border-teal); color: var(--white); }
.btn-next { background: var(--teal); color: var(--black); border: 1px solid var(--teal); font-weight: 700; }
.btn-next:hover { background: #2db09c; }

/* ── WELCOME ─────────────────────────────────────────────── */
#welcome { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: calc(100vh - 56px); padding: 64px; text-align: center; }
.welcome-logo { height: 72px; width: auto; mix-blend-mode: screen; margin-bottom: 32px; }
.welcome-tag { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); font-weight: 600; margin-bottom: 16px; font-family: 'DM Mono', monospace; }
.welcome-h1 { font-size: 48px; font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; color: var(--white); margin-bottom: 16px; max-width: 600px; }
.welcome-sub { font-size: 18px; color: var(--text-muted); line-height: 1.7; max-width: 520px; margin-bottom: 40px; font-weight: 400; }
.welcome-modules { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 40px; max-width: 580px; }
.welcome-chip { font-size: 12px; padding: 6px 14px; border-radius: 20px; background: var(--surface2); border: 1px solid var(--border); color: var(--text-muted); }
.btn-start { background: var(--teal); color: var(--black); border: none; padding: 16px 40px; border-radius: 12px; font-size: 16px; font-weight: 700; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.2s; }
.btn-start:hover { background: #2db09c; transform: translateY(-1px); }

/* ── COMPLETION ──────────────────────────────────────────── */
#completion { display: none; align-items: center; justify-content: center; min-height: calc(100vh - 56px); padding: 64px; text-align: center; flex-direction: column; }
.completion-badge { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--teal), var(--blue)); display: flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 24px; }
.completion-h { font-size: 36px; font-weight: 700; color: var(--white); margin-bottom: 12px; }
.completion-sub { font-size: 16px; color: var(--text-muted); max-width: 420px; margin-bottom: 32px; }
.completion-stats { display: flex; gap: 32px; margin-bottom: 32px; padding: 24px 32px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; }
.stat-item { text-align: center; }
.stat-num { font-size: 28px; font-weight: 700; color: var(--teal); font-family: 'DM Mono', monospace; }
.stat-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
.btn-restart { background: var(--surface2); border: 1px solid var(--border); color: var(--text); padding: 12px 28px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif; transition: all 0.2s; }
.btn-restart:hover { border-color: var(--border-teal); color: var(--white); }

/* ── SIDEBAR TOGGLE ──────────────────────────────────────── */
#sidebar-toggle { display: none; position: fixed; top: 14px; left: 14px; z-index: 200; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; width: 36px; height: 36px; align-items: center; justify-content: center; cursor: pointer; color: var(--text); font-size: 16px; }
#sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 90; backdrop-filter: blur(2px); }
#sidebar-overlay.visible { display: block; }

/* ── RESPONSIVE ──────────────────────────────────────────── */
@media (min-width: 1400px) {
  :root { --sidebar-w: 300px; }
  #content { padding: 56px 64px; }
  #toc-panel { width: 220px; padding: 56px 24px 56px 0; margin-right: 40px; }
  .module-title { font-size: 40px; }
}
@media (max-width: 1399px) and (min-width: 1024px) {
  :root { --sidebar-w: 260px; }
  #content { padding: 40px 48px; }
}
@media (max-width: 1023px) and (min-width: 768px) {
  :root { --sidebar-w: 220px; }
  #content { padding: 32px 36px; }
  .module-title { font-size: 28px; }
  .welcome-h1 { font-size: 36px; }
  .nav-title { font-size: 12px; }
  .data-table { font-size: 12px; }
  .data-table th, .data-table td { padding: 8px 10px; }
}
@media (max-width: 767px) {
  #sidebar { transform: translateX(-100%); width: 280px; z-index: 100; }
  #sidebar.open { transform: translateX(0); }
  #main { margin-left: 0 !important; }
  #content { padding: 28px 20px; }
  #topbar { padding: 0 20px 0 60px; }
  #sidebar-toggle { display: flex; }
  .module-title { font-size: 24px; }
  .module-tagline { font-size: 15px; }
  .welcome-h1 { font-size: 28px; }
  .welcome-sub { font-size: 15px; }
  #welcome { padding: 40px 24px; }
  .welcome-logo { height: 56px; }
  .section-h2 { font-size: 18px; }
  .completion-stats { gap: 20px; padding: 20px; }
  .nav-footer { flex-direction: column; gap: 12px; }
  .btn-nav { width: 100%; justify-content: center; }
  .data-table, .data-table thead, .data-table tbody, .data-table th, .data-table td, .data-table tr { display: block; }
  .data-table thead { display: none; }
  .data-table td { padding: 8px 12px; border-bottom: none; border-top: 1px solid var(--border); font-size: 14px; }
  .data-table td:first-child { background: var(--surface2); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--teal); padding-top: 12px; }
  .data-table tr { border: 1px solid var(--border); border-radius: 8px; margin-bottom: 10px; overflow: hidden; }
  .option-card { padding: 14px; }
  .option-label { font-size: 14px; }
  .question-text { font-size: 16px; }
}
@media (max-width: 419px) {
  #content { padding: 20px 16px; }
  .module-title { font-size: 22px; }
  .module-tagline { font-size: 15px; }
  .btn-nav { font-size: 14px; padding: 10px 16px; }
  .topbar-breadcrumb { font-size: 12px; }
  .tag-pill { display: none; }
  .section-h2 { font-size: 17px; }
  .card, .info-card { padding: 16px; }
  .feedback-text { font-size: 14px; }
  p, li { font-size: 15px; }
  .data-table td { font-size: 13px; padding: 8px 10px; }
}
</style>
</head>
<body>

<button id="sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle menu">☰</button>
<div id="sidebar-overlay" onclick="closeSidebar()"></div>

<div id="app">

<nav id="sidebar">
  <div class="sidebar-header">
    <div class="logo-wrap">
      <img class="logo-img" src="data:image/png;base64," alt="COINS">
    </div>
    <div class="progress-track"><div class="progress-fill" id="prog-fill" style="width:0%"></div></div>
    <div class="progress-label"><span id="prog-text">0 of 7 complete</span><span id="prog-pct">0%</span></div>
  </div>
  <div class="nav-section" id="nav-list"></div>
</nav>

<div id="main">
  <div id="topbar">
    <div style="display:flex; align-items:center; gap:16px;">
      <img src="data:image/png;base64," alt="COINS" style="height:28px;width:auto;mix-blend-mode:screen;cursor:pointer;opacity:0.85;transition:opacity 0.2s;" onclick="showWelcome()" title="Back to home">
      <div class="topbar-breadcrumb">COINS — <span id="topbar-title">Customer Experience</span></div>
    </div>
    <div class="topbar-actions">
      <span class="tag-pill">CX Onboarding</span>
    </div>
  </div>

  <div id="welcome">
    <img class="welcome-logo" src="data:image/png;base64," alt="COINS">
    <div class="welcome-tag">Customer Experience Team</div>
    <h1 class="welcome-h1">Let's get you up to speed.</h1>
    <p class="welcome-sub">Seven modules covering how COINS works, what we build, who we serve, and how to show up for customers like a pro from day one.</p>
    <div class="welcome-modules">
      <span class="welcome-chip">What Is COINS?</span>
      <span class="welcome-chip">Stablecoins 101</span>
      <span class="welcome-chip">Card Infrastructure</span>
      <span class="welcome-chip">Fiat vs. Stablecoin</span>
      <span class="welcome-chip">Product Suite</span>
      <span class="welcome-chip">Customer Stories</span>
      <span class="welcome-chip">CX Essentials</span>
    </div>
    <button class="btn-start" onclick="startCourse()">Start Course →</button>
  </div>

  <div id="content-wrap" style="display:none">
    <div id="content"></div>
    <aside id="toc-panel">
      <div id="toc-inner">
        <div class="toc-label">In this module</div>
        <nav id="toc-list"></nav>
      </div>
    </aside>
  </div>

  <div id="completion">
    <div class="completion-badge">🎉</div>
    <h2 class="completion-h">You're ready.</h2>
    <p class="completion-sub">You've completed COINS CX Onboarding. Time to put it to work.</p>
    <div class="completion-stats">
      <div class="stat-item"><div class="stat-num">7</div><div class="stat-label">Modules</div></div>
      <div class="stat-item"><div class="stat-num">14</div><div class="stat-label">Reflections</div></div>
      <div class="stat-item"><div class="stat-num">✓</div><div class="stat-label">Complete</div></div>
    </div>
    <button class="btn-restart" onclick="restartCourse()">← Start Over</button>
  </div>
</div>
</div>

<script>
// ── STATIC FEEDBACK RESPONSES ────────────────────────────────────
const staticFeedback = {
