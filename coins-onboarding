// ── STATE ─────────────────────────────────────────────────────────
let currentModule = 0;
let completedModules = new Set();
let scrollSpyTimer = null;

// ── INIT ──────────────────────────────────────────────────────────
function init() { buildNav(); }

function buildNav() {
  const nav = document.getElementById('nav-list');
  nav.innerHTML = modules.map((m, i) => `
    <button class="nav-item" id="nav-${i+1}" onclick="goToModule(${i+1})">
      <div class="nav-num">${completedModules.has(i+1) ? '✓' : String(i+1).padStart(2,'0')}</div>
      <div class="nav-title">${m.title}</div>
      <span class="nav-check">✓</span>
    </button>
  `).join('');
  updateProgress();
}

function updateProgress() {
  const pct = Math.round((completedModules.size / modules.length) * 100);
  document.getElementById('prog-fill').style.width = pct + '%';
  document.getElementById('prog-text').textContent = `${completedModules.size} of ${modules.length} complete`;
  document.getElementById('prog-pct').textContent = pct + '%';
  modules.forEach((m, i) => {
    const el = document.getElementById(`nav-${i+1}`);
    if (!el) return;
    el.className = 'nav-item' + (currentModule === i+1 ? ' active' : '') + (completedModules.has(i+1) ? ' completed' : '');
  });
}

function startCourse() { goToModule(1); }

function goToModule(num) {
  currentModule = num;
  document.getElementById('welcome').style.display = 'none';
  document.getElementById('completion').style.display = 'none';
  document.getElementById('content-wrap').style.display = 'flex';
  renderModule(num);
  updateProgress();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  document.getElementById('topbar-title').textContent = modules[num-1].title;
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebar-overlay').classList.remove('visible');
}

function renderModule(num) {
  const m = modules[num-1];
  const content = document.getElementById('content');

  let html = `
    <div class="module-eyebrow">Module ${String(num).padStart(2,'0')} — ${m.tag}</div>
    <h1 class="module-title">${m.title}</h1>
    <p class="module-tagline">${m.tagline}</p>
    <div class="module-divider"></div>
  `;

  m.sections.forEach((section, si) => {
    html += `<h2 class="section-h2" id="section-${si}">${section.heading}</h2>`;
    section.content.forEach(block => { html += renderBlock(block); });
  });

  html += `
    <div class="reflection-section" id="section-reflect">
      <div class="reflection-title">Reflect & Apply</div>
      <div class="reflection-sub">Think through these on your own — there are no wrong answers. Write something genuine, then check your thinking against a sample response.</div>
  `;

  m.reflections.forEach((q, qi) => {
    const rid = `r-${num}-${qi}`;
    const key = `${num}-${qi}`;
    html += `
      <div class="reflection-card" id="card-${rid}">
        <div class="reflection-q">${q}</div>
        <textarea class="reflection-input" id="${rid}" placeholder="Write your thoughts here…"></textarea>
        <button class="btn-feedback" onclick="showFeedback('${rid}', '${key}')">
          ✦ See a sample response
        </button>
        <div class="static-feedback" id="fb-${rid}">
          <div class="fb-label">Sample response</div>
          <div id="fb-text-${rid}"></div>
        </div>
      </div>
    `;
  });

  html += `</div>`;

  const hasPrev = num > 1;
  const isLast = num === modules.length;
  html += `
    <div class="nav-footer">
      <button class="btn-nav btn-prev" onclick="${hasPrev ? `goToModule(${num-1})` : 'showWelcome()'}" style="${!hasPrev ? 'visibility:hidden' : ''}">← ${hasPrev ? modules[num-2].title : 'Welcome'}</button>
      <button class="btn-nav btn-next" onclick="${isLast ? 'finishCourse()' : `markAndNext(${num})`}">
        ${isLast ? 'Complete Course ✓' : `${modules[num].title} →`}
      </button>
    </div>
  `;

  content.innerHTML = html;
  buildTOC(m);
  startScrollSpy(m.sections.length);
}

function renderBlock(block) {
  switch(block.type) {
    case 'prose': return `<p class="prose">${block.text}</p>`;
    case 'callout': return `<div class="callout callout-${block.variant}"><div class="callout-label">${block.label}</div><div class="callout-body">${block.body}</div></div>`;
    case 'bullets': return `<ul class="bullet-list">${block.items.map(i => `<li>${i}</li>`).join('')}</ul>`;
    case 'numbered': return `<ol class="num-list">${block.items.map(i => `<li>${i}</li>`).join('')}</ol>`;
    case 'checks': return `<ul class="check-list">${block.items.map(i => `<li>${i}</li>`).join('')}</ul>`;
    case 'table': return `<table class="data-table"><thead><tr>${block.headers.map(h => `<th>${h}</th>`).join('')}</tr></thead><tbody>${block.rows.map(r => `<tr>${r.map((c,ci) => `<td class="${c.includes('✓') ? 'highlight' : ''}">${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
    case 'quote': return `<div class="quote-block"><div class="quote-text">"${block.text}"</div><div class="quote-attr">— ${block.attr}</div></div>`;
    default: return '';
  }
}

function showFeedback(rid, key) {
  const answer = document.getElementById(rid).value.trim();
  if (!answer || answer.length < 5) { alert('Write something first — even just a few words.'); return; }
  const responses = staticFeedback[key];
  if (!responses) return;
  const response = responses[Math.floor(Math.random() * responses.length)];
  const fbEl = document.getElementById(`fb-${rid}`);
  const fbText = document.getElementById(`fb-text-${rid}`);
  fbText.textContent = response;
  fbEl.classList.add('visible');
  document.querySelector(`#card-${rid} .btn-feedback`).textContent = '↺ See another response';
}

function buildTOC(m) {
  const tocList = document.getElementById('toc-list');
  let items = m.sections.map((s, i) => `<a class="toc-item" id="toc-${i}" onclick="scrollToSection(${i})">${s.heading}</a>`);
  items.push(`<a class="toc-item" id="toc-reflect" onclick="scrollToSection('reflect')">Reflect & Apply</a>`);
  tocList.innerHTML = items.join('');
  const first = document.getElementById('toc-0');
  if (first) first.classList.add('active');
}

function scrollToSection(idx) {
  const id = idx === 'reflect' ? 'section-reflect' : `section-${idx}`;
  const el = document.getElementById(id);
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function startScrollSpy(sectionCount) {
  if (scrollSpyTimer) { clearInterval(scrollSpyTimer); scrollSpyTimer = null; }
  scrollSpyTimer = setInterval(() => {
    const ids = [...Array(sectionCount).keys()].map(i => `section-${i}`);
    ids.push('section-reflect');
    const tocIds = [...Array(sectionCount).keys()].map(i => `toc-${i}`);
    tocIds.push('toc-reflect');
    let active = 0;
    ids.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= 100) active = i;
    });
    tocIds.forEach((tid, i) => {
      const el = document.getElementById(tid);
      if (el) el.classList.toggle('active', i === active);
    });
  }, 100);
}

function markAndNext(num) { completedModules.add(num); updateProgress(); goToModule(num + 1); }

function finishCourse() {
  completedModules.add(modules.length); updateProgress();
  if (scrollSpyTimer) { clearInterval(scrollSpyTimer); scrollSpyTimer = null; }
  document.getElementById('content-wrap').style.display = 'none';
  document.getElementById('completion').style.display = 'flex';
  document.getElementById('topbar-title').textContent = 'Course Complete';
  window.scrollTo({ top: 0 });
}

function showWelcome() {
  currentModule = 0;
  if (scrollSpyTimer) { clearInterval(scrollSpyTimer); scrollSpyTimer = null; }
  document.getElementById('content-wrap').style.display = 'none';
  document.getElementById('welcome').style.display = 'flex';
  window.scrollTo({ top: 0 });
  updateProgress();
}

function restartCourse() {
  completedModules.clear(); currentModule = 0;
  document.getElementById('completion').style.display = 'none';
  document.getElementById('welcome').style.display = 'flex';
  document.getElementById('topbar-title').textContent = 'Customer Experience';
  window.scrollTo({ top: 0 });
  updateProgress();
}

function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebar-overlay').classList.toggle('visible');
}

function closeSidebar() {
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebar-overlay').classList.remove('visible');
}

function updateLayout() {
  const main = document.getElementById('main');
  const sidebar = document.getElementById('sidebar');
  if (window.innerWidth >= 768) { main.style.marginLeft = sidebar.offsetWidth + 'px'; }
  else { main.style.marginLeft = '0'; }
}

window.addEventListener('resize', updateLayout);
updateLayout();
init();
</script>
