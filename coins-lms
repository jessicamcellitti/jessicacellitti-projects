<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COINS Learn — Customer Education Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --teal:#36c6b0;
  --teal-dim:rgba(54,198,176,0.12);
  --teal-mid:rgba(54,198,176,0.25);
  --blue:#4169bf;
  --blue-dim:rgba(65,105,191,0.12);
  --black:#0d1b2a;
  --surface:#132234;
  --surface2:#1a2e42;
  --surface3:#213650;
  --border:rgba(255,255,255,0.08);
  --border2:rgba(255,255,255,0.14);
  --text:#e8f0f7;
  --muted:#a8c4d8;
  --dim:#7a9ab5;
  --white:#fff;
  --green:#2dd4a4;
  --amber:#f0a500;
  --purple:#9d7fe8;
}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--black);color:var(--text);min-height:100vh;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}

/* ── NAV ─────────────────────────────────────────────────── */
nav{
  position:sticky;top:0;z-index:100;
  background:rgba(13,27,42,0.92);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  height:62px;display:flex;align-items:center;padding:0 40px;gap:32px;
}
.nav-logo{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0;}
.nav-logo img{height:32px;mix-blend-mode:screen;}
.nav-logo-label{font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:var(--teal);font-weight:700;font-family:'DM Mono',monospace;}
.nav-links{display:flex;gap:4px;flex:1;}
.nav-link{font-size:15px;color:var(--muted);text-decoration:none;padding:6px 14px;border-radius:8px;transition:all 0.15s;font-weight:500;}
.nav-link:hover{color:var(--white);background:var(--surface2);}
.nav-link.active{color:var(--white);}
.nav-right{display:flex;align-items:center;gap:12px;flex-shrink:0;}
.nav-search{font-size:15px;
  display:flex;align-items:center;gap:8px;
  background:var(--surface);border:1px solid var(--border2);
  border-radius:8px;padding:6px 14px;
  font-size:14px;color:var(--muted);cursor:pointer;
  transition:border-color 0.2s;
}
.nav-search:hover{border-color:rgba(54,198,176,0.3);}
.nav-search kbd{font-family:'DM Mono',monospace;font-size:11px;padding:1px 5px;background:var(--surface3);border:1px solid var(--border2);border-radius:4px;color:var(--dim);}
.btn-signin{font-size:15px;color:var(--text);text-decoration:none;padding:7px 16px;border-radius:8px;border:1px solid var(--border2);transition:all 0.2s;font-weight:500;}
.btn-signin:hover{border-color:var(--teal);color:var(--teal);}
.btn-start{font-size:15px;color:var(--black);background:var(--teal);padding:8px 18px;border-radius:8px;text-decoration:none;font-weight:700;transition:all 0.2s;}
.btn-start:hover{background:#2db09c;}

/* ── HERO ─────────────────────────────────────────────────── */
.hero{
  padding:80px 40px 72px;
  max-width:1200px;margin:0 auto;
  display:grid;grid-template-columns:1fr 420px;gap:64px;align-items:center;
}
.hero-eyebrow{font-size:13px;letter-spacing:0.14em;text-transform:uppercase;color:var(--teal);font-weight:700;margin-bottom:16px;font-family:'DM Mono',monospace;}
.hero-h1{font-size:clamp(36px,4vw,52px);font-weight:700;line-height:1.1;letter-spacing:-0.02em;color:var(--white);margin-bottom:18px;}
.hero-h1 span{color:var(--teal);}
.hero-sub{font-size:19px;color:var(--muted);line-height:1.7;margin-bottom:32px;font-weight:300;max-width:480px;}
.hero-search{
  display:flex;align-items:center;gap:0;
  background:var(--surface);border:1px solid var(--border2);
  border-radius:12px;overflow:hidden;margin-bottom:28px;
  transition:border-color 0.2s;
}
.hero-search:focus-within{border-color:var(--teal);}
.hero-search-icon{padding:0 16px;color:var(--muted);font-size:18px;}
.hero-search input{flex:1;background:none;border:none;outline:none;font-size:17px;color:var(--text);font-family:'DM Sans',sans-serif;padding:14px 0;}
.hero-search input::placeholder{color:var(--dim);}
.hero-search-btn{background:var(--teal);color:var(--black);border:none;padding:0 24px;font-size:15px;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif;height:52px;transition:background 0.2s;}
.hero-search-btn:hover{background:#2db09c;}
.hero-tags{display:flex;gap:8px;flex-wrap:wrap;}
.hero-tag{font-size:14px;color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:5px 14px;cursor:pointer;transition:all 0.15s;}
.hero-tag:hover{border-color:var(--teal-mid);color:var(--teal);}

/* hero visual */
.hero-visual{
  background:var(--surface);border:1px solid var(--border);
  border-radius:16px;overflow:hidden;
}
.hero-visual-top{
  background:var(--surface2);border-bottom:1px solid var(--border);
  padding:16px 20px;display:flex;align-items:center;gap:10px;
}
.hv-dots{display:flex;gap:6px;}
.hv-dot{width:10px;height:10px;border-radius:50%;}
.hv-title{font-size:13px;color:var(--muted);font-family:'DM Mono',monospace;flex:1;text-align:center;}
.hero-visual-body{padding:20px;}
.hv-prog-label{font-size:13px;color:var(--muted);margin-bottom:8px;font-family:'DM Mono',monospace;letter-spacing:0.06em;text-transform:uppercase;}
.hv-prog-title{font-size:16px;font-weight:600;color:var(--white);margin-bottom:12px;}
.hv-prog-track{height:6px;background:var(--surface3);border-radius:4px;overflow:hidden;margin-bottom:6px;}
.hv-prog-fill{height:100%;border-radius:4px;background:var(--teal);}
.hv-prog-meta{font-size:13px;color:var(--text);display:flex;justify-content:space-between;margin-bottom:20px;}
.hv-modules{display:flex;flex-direction:column;gap:8px;}
.hv-module{
  display:flex;align-items:center;gap:12px;
  background:var(--surface3);border-radius:8px;padding:11px 14px;
}
.hv-module-icon{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.hv-module-icon.done{background:rgba(54,198,176,0.15);}
.hv-module-icon.active{background:rgba(65,105,191,0.2);}
.hv-module-icon.locked{background:rgba(255,255,255,0.04);}
.hv-module-name{font-size:14px;color:var(--text);flex:1;font-weight:500;}
.hv-module-status{font-size:12px;font-family:'DM Mono',monospace;}
.hv-module-status.done{color:var(--teal);}
.hv-module-status.active{color:var(--blue);}
.hv-module-status.locked{color:var(--dim);}
.hv-badge{margin-top:16px;background:var(--teal-dim);border:1px solid var(--teal-mid);border-radius:10px;padding:12px 14px;display:flex;align-items:center;gap:10px;}
.hv-badge-icon{font-size:20px;}
.hv-badge-text{font-size:14px;color:var(--text);font-weight:500;}
.hv-badge-sub{font-size:12px;color:var(--text);margin-top:1px;}

/* ── STATS BAR ────────────────────────────────────────────── */
.stats-bar{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface);}
.stats-inner{max-width:1200px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:repeat(4,1fr);}
.stat{padding:24px 0;border-right:1px solid var(--border);padding-left:24px;padding-right:24px;}
.stat:first-child{padding-left:0;}
.stat:last-child{border-right:none;}
.stat-num{font-size:32px;font-weight:700;color:var(--white);font-family:'DM Mono',monospace;letter-spacing:-0.02em;}
.stat-label{font-size:14px;color:var(--muted);margin-top:4px;}

/* ── SECTION COMMON ───────────────────────────────────────── */
.section{max-width:1200px;margin:0 auto;padding:64px 40px 0;}
.section-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:28px;}
.section-title{font-size:26px;font-weight:700;color:var(--white);letter-spacing:-0.01em;}
.section-sub{font-size:16px;color:var(--muted);margin-top:4px;font-weight:300;}
.see-all{font-size:15px;color:var(--teal);text-decoration:none;font-weight:600;display:flex;align-items:center;gap:4px;transition:gap 0.2s;}
.see-all:hover{gap:8px;}

/* ── LEARNING PATHS ───────────────────────────────────────── */
.paths-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}
.path-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:14px;padding:26px;cursor:pointer;
  transition:all 0.2s;position:relative;overflow:hidden;
  text-decoration:none;display:block;
}
.path-card::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,var(--accent-color,rgba(54,198,176,0.06)) 0%,transparent 60%);
  pointer-events:none;
}
.path-card:hover{border-color:var(--border2);transform:translateY(-2px);}
.path-tag{font-size:12px;letter-spacing:0.1em;text-transform:uppercase;font-family:'DM Mono',monospace;font-weight:700;margin-bottom:12px;}
.path-title{font-size:20px;font-weight:700;color:var(--white);margin-bottom:8px;line-height:1.3;}
.path-desc{font-size:15px;color:var(--muted);line-height:1.65;margin-bottom:18px;}
.path-meta{display:flex;gap:16px;align-items:center;}
.path-pill{font-size:13px;padding:4px 10px;border-radius:20px;font-family:'DM Mono',monospace;font-weight:500;}
.path-arrow{margin-left:auto;font-size:16px;color:var(--dim);transition:color 0.2s;}
.path-card:hover .path-arrow{color:var(--teal);}

/* ── COURSE GRID ──────────────────────────────────────────── */
.courses-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.course-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:12px;overflow:hidden;cursor:pointer;
  transition:all 0.2s;text-decoration:none;display:block;
}
.course-card:hover{border-color:var(--border2);transform:translateY(-2px);}
.course-thumb{
  height:120px;display:flex;align-items:center;justify-content:center;
  font-size:36px;position:relative;overflow:hidden;
}
.course-thumb-label{font-size:11px;
  position:absolute;bottom:10px;left:12px;
  font-size:10px;letter-spacing:0.1em;text-transform:uppercase;
  font-family:'DM Mono',monospace;font-weight:700;
  padding:3px 8px;border-radius:4px;
}
.course-body{padding:16px 18px 18px;}
.course-title{font-size:16px;font-weight:600;color:var(--white);margin-bottom:6px;line-height:1.35;}
.course-desc{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:14px;}
.course-meta{display:flex;align-items:center;gap:12px;}
.course-level{font-size:12px;font-family:'DM Mono',monospace;font-weight:600;}
.course-duration{font-size:13px;color:var(--muted);}
.course-progress{margin-top:10px;}
.course-prog-track{height:3px;background:var(--surface3);border-radius:2px;overflow:hidden;}
.course-prog-fill{height:100%;background:var(--teal);border-radius:2px;}
.course-prog-label{font-size:12px;color:var(--muted);margin-top:5px;}

/* ── CERTS ────────────────────────────────────────────────── */
.certs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.cert-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:14px;padding:26px;text-align:center;cursor:pointer;
  transition:all 0.2s;position:relative;overflow:hidden;
}
.cert-card:hover{border-color:var(--border2);transform:translateY(-2px);}
.cert-badge-wrap{
  width:72px;height:72px;border-radius:50%;margin:0 auto 16px;
  display:flex;align-items:center;justify-content:center;
  font-size:28px;border:2px solid;
}
.cert-name{font-size:18px;font-weight:700;color:var(--white);margin-bottom:6px;}
.cert-desc{font-size:14px;color:var(--muted);line-height:1.55;margin-bottom:18px;}
.cert-meta{font-size:14px;color:var(--muted);font-family:'DM Mono',monospace;}
.cert-btn{font-size:14px;
  display:inline-block;margin-top:14px;
  font-size:13px;font-weight:600;padding:8px 20px;
  border-radius:8px;border:1px solid;cursor:pointer;
  transition:all 0.2s;text-decoration:none;
}

/* ── PROGRESS BANNER ──────────────────────────────────────── */
.progress-banner{
  max-width:1200px;margin:64px auto 0;padding:0 40px;
}
.progress-inner{
  background:var(--surface);border:1px solid var(--border);
  border-radius:14px;padding:28px 32px;
  display:flex;align-items:center;gap:32px;
}
.progress-icon{font-size:36px;flex-shrink:0;}
.progress-content{flex:1;}
.progress-label{font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--teal);font-weight:700;font-family:'DM Mono',monospace;margin-bottom:6px;}
.progress-title{font-size:18px;font-weight:600;color:var(--white);margin-bottom:10px;}
.progress-track{height:6px;background:var(--surface3);border-radius:4px;overflow:hidden;margin-bottom:6px;}
.progress-fill{height:100%;background:var(--teal);border-radius:4px;}
.progress-meta{font-size:14px;color:var(--text);}
.progress-cta{flex-shrink:0;}
.btn-continue{background:var(--teal);color:var(--black);border:none;padding:12px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif;white-space:nowrap;transition:all 0.2s;}
.btn-continue:hover{background:#2db09c;}

/* ── POPULAR TOPICS ───────────────────────────────────────── */
.topics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.topic-chip{
  background:var(--surface);border:1px solid var(--border);
  border-radius:10px;padding:16px 18px;cursor:pointer;
  transition:all 0.2s;display:flex;align-items:center;gap:12px;
  text-decoration:none;
}
.topic-chip:hover{border-color:var(--border2);background:var(--surface2);}
.topic-icon{font-size:20px;flex-shrink:0;}
.topic-name{font-size:15px;font-weight:600;color:var(--text);}
.topic-count{font-size:14px;color:var(--muted);margin-top:1px;}

/* ── FOOTER ───────────────────────────────────────────────── */
footer{
  max-width:1200px;margin:80px auto 0;padding:40px 40px 60px;
  border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.footer-logo{display:flex;align-items:center;gap:10px;}
.footer-logo img{height:24px;mix-blend-mode:screen;}
.footer-text{font-size:14px;color:var(--muted);}
.footer-links{display:flex;gap:24px;}
.footer-link{font-size:14px;color:var(--muted);text-decoration:none;transition:color 0.15s;}
.footer-link:hover{color:var(--white);}

/* responsive */
@media(max-width:900px){
  .hero{grid-template-columns:1fr;gap:40px;}
  .hero-visual{display:none;}
  .paths-grid{grid-template-columns:1fr;}
  .courses-grid{grid-template-columns:repeat(2,1fr);}
  .certs-grid{grid-template-columns:repeat(2,1fr);}
  .topics-grid{grid-template-columns:repeat(2,1fr);}
  .stats-inner{grid-template-columns:repeat(2,1fr);}
}
@media(max-width:600px){
  nav{padding:0 20px;gap:16px;}
  .nav-links,.nav-search,.btn-signin{display:none;}
  .section{padding:48px 20px 0;}
  .hero{padding:48px 20px 40px;}
  .courses-grid{grid-template-columns:1fr;}
  .certs-grid{grid-template-columns:1fr;}
  .topics-grid{grid-template-columns:repeat(2,1fr);}
  footer{flex-direction:column;gap:20px;text-align:center;padding:32px 20px 48px;}
  .footer-links{flex-wrap:wrap;justify-content:center;}
}
</style>
</head>
